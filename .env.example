# Your timezone. Leave empty to use your saved browser timezone or system local time.
# Examples: Asia/Kolkata, America/New_York, Europe/London
APP_TIMEZONE=

# Bind to 127.0.0.1 for this computer only. Use 0.0.0.0 only behind trusted networking + auth.
HOST=127.0.0.1
PORT=8765

# Optional password for the web UI. Use HTTPS before exposing the app to the internet.
APP_PASSWORD=

# Optional bearer token for your AI agent. If empty, generate one from Settings.
AGENT_API_TOKEN=

# Optional persistent data locations. Defaults to ./data/study.db.
DATA_DIR=
DATABASE_PATH=
